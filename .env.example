# Copy to .env and edit:  cp .env.example .env
#
# The container ships no weights and downloads nothing — you supply a quantised
# GGUF and point MODELS_DIR at the folder holding it.

# --- REQUIRED unless your .gguf already sits in ./models -----------------------
# Host folder containing your *.gguf (searched recursively, mounted read-only).
#MODELS_DIR=/Users/you/Downloads/grpo_cti_gguf

# --- Optional ------------------------------------------------------------------
# Exact file INSIDE the container. Unset = first *.gguf found under /app/models.
#CTI_GGUF_PATH=/app/models/cybersentinel-cti-q4_k_m.gguf

# Host port for the SPA + API.
#HOST_PORT=5001

# Layers offloaded to GPU. 0 = CPU (correct in Docker on macOS — no Metal
# passthrough). On a CUDA host with a GPU-enabled build, -1 offloads everything.
#CTI_GPU_LAYERS=0

# llama.cpp context window. Prompts longer than this error rather than truncate.
#CTI_N_CTX=4096

# Bridge timeout for a single generation, in ms. CPU hosts need more headroom.
#CTI_TIMEOUT_MS=300000

# Build-time: add the ~2GB transformers/PEFT fallback engine (unquantised base
# model + LoRA). Not needed to serve a GGUF.
#INSTALL_TORCH=false
